{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173 --strictPort",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:4173/install",
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/session",
        "http://127.0.0.1:4173/crew",
        "http://127.0.0.1:4173/settings"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 11; moto g power (2022)) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Mobile Safari/537.36",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "onlyCategories": ["performance", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", {"maxNumericValue": 2000, "aggregationMethod": "median"}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.05, "aggregationMethod": "median"}],
        "total-blocking-time": ["error", {"maxNumericValue": 200, "aggregationMethod": "median"}],
        "categories:best-practices": ["error", {"minScore": 0.9, "aggregationMethod": "median"}]
      }
    }
  }
}
