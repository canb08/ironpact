    "@testing-library/user-event": "14.6.8",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "culori": "4.0.2",
    "eslint": "10.13.0",
